# Environment Variables
# Copy this file to .env.local and fill in the values

# Database (SQLite path is configured in drizzle.config.ts)
DATABASE_URL=./data/blog.db

# ============================================================
# AI Provider Configuration
# ============================================================
# Default provider: DeepSeek (via Anthropic-compatible API)
# Also supports Anthropic API directly — just change the URL.

# DeepSeek API Key — get yours at https://platform.deepseek.com/api_keys
ANTHROPIC_API_KEY=your-deepseek-api-key-here

# DeepSeek Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# AI Model (optional — defaults to deepseek-v4-pro)
# Options: deepseek-v4-pro (most capable) / deepseek-v4-flash (fast)
# AI_MODEL=deepseek-v4-pro

# ============================================================
# To switch to Anthropic API directly:
#   1. Change ANTHROPIC_API_KEY to your Anthropic key
#   2. Remove or comment out ANTHROPIC_BASE_URL
#   3. Set AI_MODEL=claude-opus-4-8 (or claude-sonnet-5)
# ============================================================

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-string

# App URL (used for RSS/sitemap generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
